# FastAPI server-side base URL (no trailing slash). Copy to `.env` and adjust.
# Local dev (same machine): http://localhost:8000
# Physical device on LAN: http://<your-pc-ip>:8000
# Production: https://your-api-host
EXPO_PUBLIC_BASE_API_URL=http://localhost:8000
# Must match server BOOKING_TZ / TZ (e.g. Asia/Karachi or Europe/Madrid)
EXPO_PUBLIC_BOOKING_TIME_ZONE=Asia/Karachi
