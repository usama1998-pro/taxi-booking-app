{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BASE_API_URL": "https://taxibarcelonas.com",
        "EXPO_PUBLIC_BOOKING_TIME_ZONE": "Europe/Madrid"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BASE_API_URL": "https://taxibarcelonas.com",
        "EXPO_PUBLIC_BOOKING_TIME_ZONE": "Europe/Madrid"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BASE_API_URL": "https://taxibarcelonas.com",
        "EXPO_PUBLIC_BOOKING_TIME_ZONE": "Europe/Madrid"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
